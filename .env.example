# McNutt Legacy — environment template. Production values live in /etc/mcnutt-legacy/legacy.env (root:mcnutt-legacy 0640),
# created by deploy. Never commit real secrets.
APP_NAME="McNutt Legacy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://legacy.mcnutt.cloud
LEGACY_RELEASE=

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mcnutt_legacy
DB_USERNAME=mcnutt_legacy
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_COOKIE=__Host-mcnutt_legacy_session
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=sync
TRUSTED_PROXIES=

# McNutt Cloud SSO (register app "legacy.mcnutt.cloud", callback https://legacy.mcnutt.cloud/auth/callback)
AUTH_DRIVER=mcnutt
AUTH_LOGIN_BASE=https://login.mcnutt.cloud
AUTH_APP_ID=
AUTH_APP_SECRET=
AUTH_EXPECTED_ISSUER=https://login.mcnutt.cloud
AUTH_VALIDATE_ENDPOINT=https://login.mcnutt.cloud/api/validate.php
AUTH_LOGIN_URL_TEMPLATE="{login_base}/?return_url={return_url}&app_id={app_id}"
AUTH_LOGOUT_URL_TEMPLATE="{login_base}/logout_confirm.php?token={token}&return_url={return_url}"
AUTH_REVALIDATE_SECONDS=300
AUTH_FRESH_SECONDS=60
AUTH_ABSOLUTE_SESSION_HOURS=12
AUTH_EMAIL_IS_VERIFIED=false
# Comma-separated McNutt Cloud uids allowed to create a workspace (the family administrator).
LEGACY_WORKSPACE_CREATORS=
# Verified McNutt Cloud roles: who may create workspaces, and central role -> workspace role.
# Roles control membership only; data access always comes from scope grants. guest/vault are intentionally unmapped.
LEGACY_CREATOR_ROLES=admin
LEGACY_ROLE_SYNC=true
LEGACY_ROLE_MAP=admin:administrator,family:member,ice:emergency_contact

STEPUP_REQUIRED=true
STEPUP_TTL_SECONDS=600

# Vault: 32-byte base64 key-encryption key held outside the database and its backups.
LEGACY_PRIVATE_STORAGE=/var/lib/mcnutt-legacy/vault
LEGACY_JOB_DIR=/var/lib/mcnutt-legacy/jobs
VAULT_ROOT_KEY=
VAULT_ROOT_KEY_ID=k1
VAULT_PREVIOUS_KEYS=
VAULT_SCANNER=auto
VAULT_REQUIRE_SCAN=false

# Python runner (release-local virtual environment)
RUNNER_PYTHON=/opt/mcnutt-legacy/current/runners/.venv/bin/python
RUNNER_MEMORY_MB=768
RUNNER_THREADS=1
RUNNER_SANDBOX=none

# notifications.mcnutt.cloud (app-scoped token)
NOTIFICATIONS_DRIVER=mcnutt
NOTIFICATIONS_API_TOKEN=
NOTIFICATIONS_FROM="McNutt Legacy <legacy@mcnutt.cloud>"
NOTIFICATIONS_PROVIDER=

# Optional AI extraction (also requires workspace consent)
OPENAI_EXTRACTION_ENABLED=false
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.1-mini

# MCP / ChatGPT
MCP_ENABLED=true
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
MCP_REDIRECT_HOSTS=chatgpt.com,chat.openai.com
MCP_DYNAMIC_REGISTRATION=true
FEATURE_CHAT_ATTACHMENTS=false

LEGACY_BACKUP_STATUS_FILE=/var/lib/mcnutt-legacy/backup-status.json
